# Copy to .env.local. Names only: never commit real values.

# Expo client. These are public values that get bundled into the app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CONVEX_URL=

# Optional. Set to 1 to show "Load sample contacts" on People in a Release build
# (development builds and Expo Go always show it). The Revyl preview profile sets it.
EXPO_PUBLIC_DEMO_MODE=

# Written for you by "npx convex dev".
CONVEX_DEPLOYMENT=

# Convex deployment variables are not read from this file.
# Set them with "npx convex env set <NAME> <value>":
#   CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL (https://<slug>.clerk.accounts.dev)
#   OPENAI_API_KEY            used by the matching and sticker actions
#   OPENAI_STICKER_IMAGE_MODEL  optional, image model for conversation stickers (default gpt-image-1.5; must support transparent backgrounds)
#   PHONE_HMAC_PEPPER         random secret, e.g. "openssl rand -hex 32"
# Optional:
#   OPENAI_MATCH_MODEL        model for matching (default gpt-5.4-mini)
#   MATCH_THRESHOLD           minimum score for an invitation (default 0.6)
#   CHAT_WINDOW_MS            how long a conversation stays open (default 86400000, 24 hours)
