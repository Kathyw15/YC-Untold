{
  "expo": {
    "name": "Seal",
    "slug": "untold",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "untold",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F7FA",
    "ios": {
      "bundleIdentifier": "app.untold.ios",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.untold.android"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7FA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-contacts",
        {
          "contactsPermission": "Seal checks your contacts to find the people you know who are already here. Names never leave your phone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Seal uses your photo library only when you choose a profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
